# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000

# Supabase  (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the SERVICE ROLE key. It stays on the server only, never in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=report-images

# JWT  (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Protects /api/admin/* (chaos controls, stats, reset). Any long random string.
ADMIN_KEY=

# Limits
MAX_IMAGE_BYTES=5242880
SIGNED_URL_TTL_SECONDS=3600

# CORS  (* is fine for a mobile client; set a real origin for a web client)
CORS_ORIGIN=*
