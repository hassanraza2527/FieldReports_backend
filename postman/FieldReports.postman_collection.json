{
  "info": {
    "name": "Field Reports API",
    "description": "Backend for the Field Reports app. Start with Auth -> Login, then Reports (upload flow).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "inspector@example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd!123"
    },
    {
      "key": "adminKey",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "imageId1",
      "value": ""
    },
    {
      "key": "imageId2",
      "value": ""
    },
    {
      "key": "incompleteReportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name\": \"Field Inspector\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Creates the account and returns a token. 409 EMAIL_TAKEN if you already registered (then use Login)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created or 409 already registered', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Saves the token into the {{token}} collection variable. Every other request uses it automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (wrong password -> 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Swaps a still-valid token for a fresh one. An expired token must log in again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports (upload flow)",
      "description": "Run 1 -> 6 in order. Pick a small JPEG for the two upload requests (Body -> file -> Select file).",
      "item": [
        {
          "name": "1. Create report (generates NEW ids)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Cracked pipe near gate 4\",\n  \"imageIds\": [\n    \"{{imageId1}}\",\n    \"{{imageId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Declares the report and its image ids. The ids are generated here, exactly like the mobile app generates them."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('reportId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('imageId1', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('imageId2', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.test('status is pending', () => pm.expect(pm.response.json().status).to.eql('pending'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2a. Upload image 1",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/images/{{imageId1}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}",
                "images",
                "{{imageId1}}"
              ]
            },
            "body": {
              "mode": "file",
              "file": {}
            },
            "description": "Body tab -> binary -> select a .jpg (max 5 MB)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('uploaded', () => pm.expect(pm.response.json().uploaded).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Upload image 2",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/images/{{imageId2}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}",
                "images",
                "{{imageId2}}"
              ]
            },
            "body": {
              "mode": "file",
              "file": {}
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Status (resume info)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('2 images received', () => pm.expect(pm.response.json().receivedImageIds.length).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Commit",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/commit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}",
                "commit"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('committed', () => pm.expect(pm.response.json().status).to.eql('committed'));",
                  "pm.test('images have signed urls', () => pm.response.json().images.forEach(i => pm.expect(i.url).to.be.a('string')));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. List my reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('contains our report once', () => pm.expect(pm.response.json().reports.filter(r => r.id === pm.collectionVariables.get('reportId')).length).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Commit AGAIN (idempotent -> still 200)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/commit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}",
                "commit"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('still 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Re-send SAME create (idempotent -> 200, no duplicate)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{reportId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Cracked pipe near gate 4\",\n  \"imageIds\": [\n    \"{{imageId1}}\",\n    \"{{imageId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 not 201', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Commit with missing image (expect 409)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{incompleteReportId}}/commit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{incompleteReportId}}",
                "commit"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build a brand new report with one image that is never uploaded.",
                  "const rid = pm.variables.replaceIn('{{$guid}}');",
                  "const iid = pm.variables.replaceIn('{{$guid}}');",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/api/reports/' + rid,",
                  "  method: 'PUT',",
                  "  header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.collectionVariables.get('token') },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ description: 'incomplete', imageIds: [iid] }) },",
                  "}, () => {});",
                  "pm.collectionVariables.set('incompleteReportId', rid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 IMAGES_MISSING or 404 if setup raced', () => pm.expect([409, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation & errors",
      "item": [
        {
          "name": "Blank description -> 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{$guid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "{{$guid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"   \",\n  \"imageIds\": [\n    \"{{$guid}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Zero images -> 400",
          "request": {
            "method": "PUT",
            "header": [
              {
