    {
      "name": "Admin & failure injection",
      "description": "Uses the x-admin-key header ({{adminKey}}), not the JWT. Chaos only affects /api/reports/* and resets when the server restarts.",
      "item": [
        {
          "name": "Current chaos settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/chaos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "chaos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Latency 5s",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/chaos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "chaos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latencyMs\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Every /api/reports request waits 5 seconds first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Drop 30% of connections",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
